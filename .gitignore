# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files - prevent ALL env files except examples
.env*
!.env.example

# Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Uploads directory
uploads/

# Files storage directory (development mirror of /srv/files)
files/

# Database
*.db
*.sqlite
*.sqlite3

# OS Files
.DS_Store
Thumbs.db

# Backup files
*.backup
*.old
*.bak

# Build info
.build-info.json
# WhatsApp session data
.wwebjs_auth/

# Firebase credentials
firebase-service-account.json
**/firebase-service-account*.json
config/firebase*.json

# Published OTA (Expo Updates) bundles — build artifacts, keep the folder only
/updates/*
!/updates/.gitkeep

# Stock-correction / data-correction CSV reports (local artifacts)
scripts/output/

# Certificados ICP-Brasil (A1). NUNCA versionar.
# `certs/certificate.pfx` esteve versionado — apos remover daqui, ele continua
# recuperavel no historico do git, entao o certificado precisa ser REVOGADO e
# reemitido, nao apenas apagado.
certs/
*.pfx
*.p12

# Dumps manuais do banco — nunca versionados.
# Contêm dados de pessoal (nome, status de contrato) e folha (remuneração base,
# INSS, IRRF, abono). São instantâneos operacionais: envelhecem sozinhos e, uma
# vez no histórico do git, não saem mais. Mesma razão pela qual .env* é ignorado.
prisma/manual/

# Python bytecode (painting-engine)
__pycache__/
*.py[cod]

# Árvore de assets 3D do Truck Studio servida em /studio-assets/.
# NÃO é do repositório: são centenas de MB de geometria e HDRI, empurrados por
# rsync para /srv/studio-assets/<versão>/ (ver STUDIO_ASSETS_ROOT no .env.example).
# Em dev isto costuma ser um symlink para web/public — commitar o link quebraria
# a árvore de qualquer outra máquina.
studio-assets/
