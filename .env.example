# API Environment Variables - EXAMPLE
# Copy this file to .env.development, .env.staging, or .env.production and fill in actual values

# ==============================================
# REQUIRED VARIABLES
# ==============================================

# Environment (development, staging, production)
NODE_ENV="development"

# Timezone — pin to the business timezone so scheduled-order date math, the
# same-day dedupe boundary, and Brazilian-holiday business-day shifts all agree.
# (Also set in ecosystem.config.js for the pm2-managed processes.)
TZ="America/Sao_Paulo"

# Order-schedule cron control:
#   ORDER_SCHEDULE_CRON_DEV=1      -> run the hourly order-schedule cron in
#                                    non-production (off by default to avoid
#                                    creating orders during local dev).
#   ORDER_SCHEDULE_CRON_ENABLED=0  -> production kill-switch (disable the cron
#                                    for incident response). Defaults to enabled.
# ORDER_SCHEDULE_CRON_DEV="0"
# ORDER_SCHEDULE_CRON_ENABLED="1"

# Server Configuration
PORT=3030

# Database (REQUIRED)
# Development: postgresql://username:password@127.0.0.1:5432/ankaa_dev?schema=public
# Staging:     postgresql://username:password@host:5432/ankaa_staging?schema=public
# Production:  postgresql://username:password@host:5432/ankaa_production?schema=public
# NOTE: Use 127.0.0.1 instead of localhost when using Docker on macOS
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/database_name?schema=public"

# PostgreSQL Docker Credentials (for docker-compose)
POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_DB="database_name"

# JWT Authentication (REQUIRED - must be at least 32 characters)
# Generate using: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-change-this"
# JWT_EXPIRATION is DEPRECATED (no longer the access-token lifetime). Kept only
# for backward compatibility. Use JWT_ACCESS_EXPIRATION below instead.
JWT_EXPIRATION="7d"
# Short-lived ACCESS token lifetime. Users never see this expire — the refresh
# token renews it silently. Keep this GENEROUS (e.g. "7d") until BOTH the web and
# mobile clients that support refresh tokens are fully rolled out, because old
# clients cannot refresh and would be logged out when the access token expires.
# Once new clients are adopted, tighten to "1h" (env-only change, no redeploy).
JWT_ACCESS_EXPIRATION="30d"
# Long-lived REFRESH token lifetime, in days. Backs the access token; stored
# server-side as a hash (RefreshToken table) and revoked on logout.
JWT_REFRESH_EXPIRATION_DAYS="365"

# ==============================================
# API & CORS CONFIGURATION
# ==============================================

# API Configuration
# Development: http://localhost:3030
# Staging:     https://api.staging.ankaadesign.com.br
# Production:  https://api.ankaadesign.com.br
API_URL="http://localhost:3030"
API_BASE_URL="http://localhost:3030"

# Client/CORS Configuration
# Development: http://localhost:5173
# Staging:     https://staging.ankaadesign.com.br
# Production:  https://ankaadesign.com.br
CLIENT_HOST="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ==============================================
# FILE UPLOAD & STORAGE
# ==============================================

# Temporary upload directory (files are staged here before moving to FILES_ROOT)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=524288000
MAX_UPLOAD_FILES=10000
MAX_UPLOAD_SIZE_MB=10000
ALLOWED_FILE_TYPES="image/*,application/pdf,application/msword"
FILE_URL_PREFIX="/files"

# Files Storage Configuration
# Development: FILES_ROOT="./files"
# Production:  FILES_ROOT="/srv/files" (served by nginx via arquivos.ankaadesign.com.br, accessible locally via Samba)
FILES_ROOT="./files"

# Files Base URL (public URL for file access via nginx)
# Development: FILES_BASE_URL="http://localhost:3030"
# Production:  FILES_BASE_URL="https://arquivos.ankaadesign.com.br"
FILES_BASE_URL="http://localhost:3030"

# Truck Studio 3D Assets (served publicly at /studio-assets/)
# Development: STUDIO_ASSETS_ROOT="./studio-assets"
# Production:  STUDIO_ASSETS_ROOT="/srv/files/Estudio3D"
#
# Produção mora DENTRO de /srv/files, como irmão de Artes/Clientes/Tintas, e não
# num /srv/studio-assets à parte. O motivo é operacional: `files-sync.sh` espelha
# /srv/files/ para o HDD e de lá para o Google Drive. Fora dessa árvore, os
# 451 MB de geometria não são copiados para lugar nenhum.
#
# Isso é SINCRONIZAÇÃO, não backup: a fase do Drive é `rclone sync`, um espelho —
# o que sumir daqui some de lá. Só a fase do HDD guarda o que foi apagado, num
# cemitério datado. Não trate o Drive como cofre de versões.
#
# This tree is NOT in git. models/vehicles/trailer.glb alone is ~300 MB and
# GitHub hard-rejects any blob over 100 MB, so the assets are gitignored: they
# exist only on the disk of whoever authored them until someone PUSHES THEM BY
# RSYNC. A fresh deploy with an empty (or missing) directory 404s every model.
#
#   rsync -av --delete web/public/ deploy@api-host:/srv/files/Estudio3D/v1/
#
# Versioned BY SUBDIRECTORY (/srv/files/Estudio3D/v1, v2, ...), not by query
# string, because the mount answers Cache-Control: immutable — a published URL
# promises its bytes never change. Ship new geometry as a NEW vN directory and
# repoint the web build at it; never overwrite files inside a live vN, or you
# have a year-long stale-cache bug with nothing left to bust it with.
#
# Optionally pre-compress the only two families that actually shrink (see the
# measured numbers in main.ts). Everything else is already-compressed bytes:
#   brotli -q 11 -k /srv/files/Estudio3D/v1/models/vehicles/trailer.glb
#   brotli -q 11 -k /srv/files/Estudio3D/v1/environments/*/sky.hdr
STUDIO_ASSETS_ROOT="./studio-assets"

# ==============================================
# PERFORMANCE & CACHING
# ==============================================

# Redis Cache (Optional)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_DB=0

# Rate Limiting
DISABLE_RATE_LIMITING="false"

# ==============================================
# LOGGING & MONITORING
# ==============================================

LOG_LEVEL="debug"
LOG_DIR="./logs"
LOG_FORMAT="json"
ENABLE_CONSOLE_LOGS="true"
ENABLE_FILE_LOGS="false"

HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000
ENABLE_METRICS="false"
METRICS_ENDPOINT="/metrics"

# ==============================================
# SECURITY
# ==============================================

CSP_REPORT_URI="/api/security/csp-report"
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS="false"
HSTS_PRELOAD="false"
SESSION_MAX_AGE=86400000

# ==============================================
# EXTERNAL SERVICES (All Optional)
# ==============================================

# Twilio SMS Service
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================

# SMTP Server Configuration
# Common providers:
# - Gmail:        smtp.gmail.com (port 587, secure=false for STARTTLS)
# - Outlook:      smtp-mail.outlook.com (port 587, secure=false)
# - SendGrid:     smtp.sendgrid.net (port 587, secure=false)
# - Mailgun:      smtp.mailgun.org (port 587, secure=false)
# - Amazon SES:   email-smtp.[region].amazonaws.com (port 587, secure=false)
# - Custom SMTP:  Your SMTP server address

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-here"

# Email From Configuration
# This will be shown as the sender in recipient's inbox
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="Your Company Name"

# Template Configuration
# Directory where email templates are stored
EMAIL_TEMPLATES_DIR="./src/templates/emails"

# Legacy Email Variables (for backward compatibility)
# EMAIL_USER="your-gmail-address@gmail.com"
# EMAIL_PASS="your-16-char-gmail-app-password"

# Secullum Integration
# SECULLUM_BASE_URL="https://pontoweb.secullum.com.br"
# SECULLUM_EMAIL=""
# SECULLUM_PASSWORD=""
# SECULLUM_DATABASE_ID="4c8681f2e79a4b7ab58cc94503106736"
# SECULLUM_CLIENT_ID="3"
# SECULLUM_CLIENT_SECRET=""

# ==============================================
# NOTIFICATION SYSTEM
# ==============================================

# Notification Queue Configuration
NOTIFICATION_QUEUE_CONCURRENCY=5

# WhatsApp (whatsapp-web.js)
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Chaves de NotificationConfiguration liberadas a sair por WhatsApp, separadas
# por virgula. VAZIO = nenhuma, que e a politica vigente desde 2026-08-17.
#
# Existe porque desligar o canal nos 204 configs do banco e reversivel com um
# clique: PUT /notification-configurations/:id/channels/WHATSAPP rearma qualquer
# config pela tela, e POST /notifications com channel:['WHATSAPP'] explicito nem
# consulta o registro. O numero anterior foi banido por volume; o novo carrega
# OTP de assinatura de contrato, e um banimento no meio de uma coleta derruba a
# cerimonia inteira.
#
# A trava age em DOIS pontos (dispatchToChannel e o worker da fila), de forma que
# tambem pega job ja enfileirado e notificacao agendada que congelou o canal
# antes da politica. NAO afeta a cerimonia de assinatura do orcamento: aquela usa
# a ponte propria e obedece SIGNATURE_DELIVERY_CHANNEL.
#
# E allowlist, e nao denylist, porque o custo dos dois erros e assimetrico:
# esquecer de bloquear uma chave nova custa um banimento; esquecer de liberar uma
# custa uma notificacao que chega por push.
WHATSAPP_NOTIFICATION_ALLOWLIST=

# Firebase Cloud Messaging (FCM) for Push Notifications
# Option 1: Use individual environment variables (recommended for production)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Option 2: Use service account file path (recommended for development)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Note: Only one option is required. If both are provided, the service account file takes precedence.

# Expo Push Notifications (for mobile app using Expo)
# Get access token from https://expo.dev/accounts/[account]/settings/access-tokens
# Without this token, you're limited to 600 push notifications per hour (free tier)
# With access token, rate limits are significantly higher
EXPO_ACCESS_TOKEN=

# Push Notifications
WEB_APP_URL=https://ankaadesign.com.br
MOBILE_APP_SCHEME=ankaadesign

# Deep Linking
WEB_BASE_URL=https://ankaadesign.com.br
MOBILE_UNIVERSAL_LINK=https://ankaadesign.com.br/app
UNIVERSAL_LINK_DOMAIN=https://ankaadesign.com.br

# ==============================================
# PPE IN-APP SIGNATURE
# ==============================================

# Gere com `openssl rand -hex 32`. NUNCA preencha este arquivo com o valor real —
# ele e versionado. O valor de producao vive em .env.production, que e ignorado.
PPE_SIGNATURE_HMAC_SECRET="gere-com-openssl-rand-hex-32-e-nao-comite-o-valor-real"

# PAdES seal — ICP-Brasil cert applied server-side to every signed PPE delivery PDF.
# When configured, every signed PPE delivery PDF is sealed with this cert (PAdES-B-B).
# Path is resolved relative to the api/ root.
PPE_CERT_PATH="./certs/certificate.pfx"
PPE_CERT_PASSWORD=""
# Optional RFC 3161 timestamp authority — leave empty to produce PAdES-B-B without timestamp.
# Example: https://freetsa.org/tsr
PPE_TSA_URL=""

# ==============================================
# NFS-e NACIONAL (Nota Fiscal de Serviço Eletrônica)
# ==============================================

# Master gate for the NFSe emission scheduler. OFF by default — flip to "true"
# only once the city has migrated and credentials are in place.
NFSE_SCHEDULER_ENABLED=false

# ----------------------------------------------------------------------------
# NFS-e do AEROGRAFISTA (prestador terceiro, MEI) — Sistema Nacional / SEFIN
#
# Caminho separado do municipal acima: aqui o pintor é o PRESTADOR e a Ankaa é a
# TOMADORA, e a nota é assinada com o certificado A1 do próprio pintor.
# ----------------------------------------------------------------------------

# Trava mestra da varredura de emissão. OFF por padrão porque o job cria
# documento fiscal REAL quando o emitente está em ambiente de produção.
# Cada pintor tem ainda a sua própria trava (emissionEnabled no perfil fiscal).
PAINTER_NFSE_SCHEDULER_ENABLED=false

# Chave que protege os certificados A1 guardados no banco (32 bytes em base64):
#   openssl rand -base64 32
# OBRIGATÓRIA em produção. Sem ela a chave é derivada do JWT_SECRET, e aí
# rotacionar o JWT torna TODOS os certificados indecifráveis de uma vez.
# Trocar esta chave exige re-embrulhar as DEKs (coluna kekVersion).
FISCAL_CERT_KEK=

# Sobrescreve a URL base da SEFIN Nacional. Vazio usa o padrão conforme o
# ambiente do emitente: 1 = https://sefin.nfse.gov.br/SefinNacional,
# 2 = https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
NFSE_NACIONAL_BASE_URL=
NFSE_NACIONAL_TIMEOUT_MS=60000

# Par de algoritmos da assinatura XMLDSig. Padrão "sha1", que é o que o
# xmldsig-core-schema restrito do leiaute fixa e o que toda implementação de
# referência usa (mesma escolha da NF-e). Só mude para "sha256" se a SEFIN
# passar a exigir.
NFSE_SIGNATURE_ALGORITHM=sha1

# Environment: 1 = Produção, 2 = Homologação (sandbox)
NFSE_ENVIRONMENT=2

# SEFIN API URL (auto-selected based on NFSE_ENVIRONMENT if not set)
# Homologação: https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# Produção:    https://sefin.nfse.gov.br/sefinnacional
# NFSE_API_URL=

# ADN API URL (auto-selected based on NFSE_ENVIRONMENT if not set)
# Homologação: https://adn.producaorestrita.nfse.gov.br
# Produção:    https://adn.nfse.gov.br
# NFSE_ADN_URL=

# Company identity (numbers only, no formatting). Used by bank reconciliation +
# SIEG integration; scopes the marketplace value-only matcher to our own
# purchases (ENTRADA, destCnpj = this). Falls back to a hardcoded default if unset.
COMPANY_CNPJ=

# Company CNPJ (numbers only, no formatting)
NFSE_CNPJ=

# Municipal registration number (Inscrição Municipal)
NFSE_INSCRICAO_MUNICIPAL=

# IBGE city code (7 digits) - e.g., 4106902 for Curitiba
NFSE_CITY_CODE=

# Service codes
# National service classification code (cTribNac) from LC 116
NFSE_NATIONAL_SERVICE_CODE=
# Municipal service code (optional, municipality-specific)
NFSE_MUNICIPAL_SERVICE_CODE=

# ISS tax rate (decimal, e.g., 0.05 for 5%)
NFSE_ISS_RATE=0.05

# Digital certificate (ICP-Brasil A1 - .pfx file)
# Required for both sandbox and production
NFSE_CERTIFICATE_PATH=./certs/certificate.pfx
NFSE_CERTIFICATE_PASSWORD=

# ==============================================
# ELOTECH OXY - MUNICIPAL NFSe (Ibiporã)
# ==============================================

# Elotech OXY portal REST API base URL
ELOTECH_OXY_BASE_URL=https://ibipora.oxy.elotech.com.br/iss-api/api

# Login credentials (CPF of the user)
ELOTECH_OXY_USERNAME=
ELOTECH_OXY_PASSWORD=

# Internal company ID in Elotech system (from contribuinte-padrao endpoint)
ELOTECH_OXY_EMPRESA_ID=

# CNAE code and description for the company's main activity
ELOTECH_OXY_CNAE=4520002
ELOTECH_OXY_CNAE_DESCRICAO=Servicos de lanternagem ou funilaria e pintura de veiculos automotores

# Service code per LC 116 (subitem)
ELOTECH_OXY_SERVICO_LC_ID=141201
ELOTECH_OXY_SERVICO_LC_ALIQUOTA=2
ELOTECH_OXY_SERVICO_LC_DESCRICAO=Funilaria e lanternagem.
ELOTECH_OXY_SERVICO_LC_LOCAL_INCIDENCIA=2
ELOTECH_OXY_SERVICO_LC_TIPO_SERVICO=1
ELOTECH_OXY_ID_SERVICO=2739

# Emission city (Ibiporã)
ELOTECH_OXY_CITY_ID=4049
ELOTECH_OXY_CITY_IBGE=4109807
ELOTECH_OXY_CITY_NAME=IBIPORA

# ==============================================
# SICREDI BOLETO INTEGRATION
# ==============================================

# Sicredi API base URL (production partner API)
SICREDI_API_URL="https://api-parceiro.sicredi.com.br"

# Cooperativa and Posto (agency identifiers)
SICREDI_COOPERATIVA=
SICREDI_POSTO=

# Código do Beneficiário (beneficiary code)
SICREDI_CODIGO_BENEFICIARIO=

# Código de Acesso (access code / master key from Internet Banking)
SICREDI_CODIGO_ACESSO=

# Client ID (x-api-key for API authentication)
SICREDI_X_API_KEY=

# HMAC-SHA256 shared secret used to verify Sicredi webhook callbacks.
# Required in production. If unset in dev/staging, signature verification is bypassed.
SICREDI_WEBHOOK_SECRET=

# Self-service password recovery — set to "false" to temporarily disable the public reset endpoints
PASSWORD_RECOVERY_ENABLED=true

# =============================================================================
# ASSINATURA ELETRONICA DO ORCAMENTO
# =============================================================================
# Certificado A1 ICP-Brasil usado no selo PAdES. Se ausente, cai em
# PPE_CERT_PATH/PPE_CERT_PASSWORD (mesmo certificado usado hoje pelos fluxos de RH).
SIGNATURE_CERT_PATH=
SIGNATURE_CERT_PASSWORD=

# Autoridade de Carimbo do Tempo (RFC 3161). Sem ela o selo fica em PAdES-B-B,
# isto e, a hora e a do proprio servidor — que e exatamente a objecao que a
# contraparte levanta primeiro num litigio. Com ACT credenciada ICP-Brasil o selo
# sobe para B-T / AD-RT (DOC-ICP-15).
# ACTs credenciadas: Serpro, Certisign, Valid, Bry, Soluti, Safeweb, Caixa,
# Quicksoft, Prodesp. Revenda com onboarding mais simples: Lacuna Rest PKI
# (https://pki.rest/tsp/{tenant-id}).
SIGNATURE_TSA_URL=
SIGNATURE_TSA_USER=
SIGNATURE_TSA_PASSWORD=
SIGNATURE_TSA_TIMEOUT_MS=10000
# true = falha fechada: sem carimbo, nao sela.
SIGNATURE_TSA_REQUIRED=false

# Pepper do HMAC sobre a evidencia da assinatura. DISTINTO de
# PPE_SIGNATURE_HMAC_SECRET (aquele esta commitado no repositorio e precisa ser
# rotacionado). Gere com: openssl rand -hex 32
#
# OBRIGATORIO, minimo 32 caracteres: o SignatureModule DERRUBA O BOOT da API se
# faltar, for curto ou for igual a PPE_SIGNATURE_HMAC_SECRET / ao pepper de OTP.
# Antes, a ausencia so fazia hmacSignature=null em silencio e a evidencia
# perdia a prova de origem sem ninguem perceber.
SIGNATURE_HMAC_SECRET=

# Pepper do HMAC dos codigos OTP. O codigo em si NUNCA e persistido nem logado.
# Gere com: openssl rand -hex 32
# OBRIGATORIO, minimo 32 caracteres — mesma verificacao de boot acima.
SIGNATURE_OTP_PEPPER=

# Caminho do Chromium quando o browser empacotado do Playwright nao existe
# (a imagem de producao instala o chromium do Alpine em /usr/bin/chromium).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Ecoa o codigo OTP no log em vez de envia-lo. Duas travas: exige
# NODE_ENV != production E esta flag. Apenas para desenvolvimento.
SIGNATURE_DEV_ECHO_OTP=false

# Canal do convite e do codigo de assinatura do orcamento.
#   whatsapp  convite + OTP por WhatsApp (padrao)
#   email     convite + OTP por e-mail
#   both      o operador escolhe UM dos dois na pagina da tarefa a cada coleta
#
# "both" NAO duplica a mensagem: mandar o mesmo codigo para duas caixas dobraria
# o custo no WhatsApp e dividiria a prova de autoria entre dois contatos.
#
# Valor ausente ou invalido cai em "email" e registra erro no log — nao
# derruba o boot, para que uma variavel mal digitada nao pare a emissao de
# orcamentos.
#
# O default e "email" desde 2026-08-17, e a razao e operacional: o WhatsApp
# passou a recusar os convites com o nack 463 (SenderReachoutTimelocked), que
# impede a conta de INICIAR conversa com quem nao tem TC token. Um envelope que
# nasce em whatsapp nasce impossivel de assinar, porque o OTP segue o canal
# gravado no signatario e nao ha queda para e-mail. O default aponta para o
# canal que entrega.
#
# O canal escolhido e GRAVADO em EnvelopeSigner.authMethod (WHATSAPP_OTP /
# EMAIL_OTP) na emissao. Reenvio e reemissao de OTP leem de la, nao daqui: uma
# coleta em andamento continua no canal em que nasceu mesmo depois de a
# variavel mudar — trocar o canal no meio redirecionaria o segundo fator para
# outro contato e derrubaria o envelope na proxima conferencia do hash material.
#
# Exige contato cadastrado no canal correspondente: Responsible.phone (NOT NULL)
# para whatsapp, Responsible.email (opcional!) para email. A emissao recusa com
# mensagem nomeando quem esta sem o contato.
SIGNATURE_DELIVERY_CHANNEL=email

# Base das URLs publicas de assinatura. Se vazio, cai em WEB_APP_URL.
# Em desenvolvimento aponte para o servidor do Vite (http://localhost:5173),
# senao os links gerados apontam para producao e dao 404.
SIGNATURE_WEB_URL=
