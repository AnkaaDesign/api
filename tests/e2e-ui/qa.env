# ═══════════════════════════════════════════════════════════════════════════
# BLINDAGEM DO E2E DE UI — nada sai desta máquina.
#
# Estas variáveis são EXPORTADAS no shell, e `export` VENCE o `.env`
# (o ConfigModule usa dotenv sem override). Confirme sempre no log de boot.
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3031
# A URL do banco sai do `.env` do repositório com o nome do banco trocado —
# ver `start-stack.sh`. Credencial não entra em arquivo versionado.
QA_DB_NAME=ankaa_qa_e2e
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3

# A UI de teste roda na 5174 para não encostar na sessão que já está de pé na 5173.
WEB_APP_URL=http://localhost:5174
WEB_BASE_URL=http://localhost:5174
SIGNATURE_WEB_URL=http://localhost:5174
CLIENT_HOST=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
API_URL=http://localhost:3031
API_BASE_URL=http://localhost:3031

# ── TUDO QUE FALARIA COM O MUNDO APONTA PARA A SENTINELA ──────────────────
ELOTECH_OXY_BASE_URL=http://127.0.0.1:9988/elotech
SICREDI_API_URL=http://127.0.0.1:9988/sicredi
NFSE_NACIONAL_BASE_URL=http://127.0.0.1:9988/nfse-nacional
CLICKSIGN_API_URL=http://127.0.0.1:9988/clicksign
SIGNATURE_TSA_URL=http://127.0.0.1:9988/tsa
SIGNATURE_TSA_REQUIRED=false

# ── E-MAIL: Mailpit dedicado (1026/8026), não o do outro projeto ──────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=qa@ankaa.test
SMTP_FROM_NAME="Ankaa QA"
EMAIL_USER=qa@ankaa.test
EMAIL_PASS=mock

# ── WHATSAPP / PUSH: desligados ───────────────────────────────────────────
DISABLE_WHATSAPP=true
WHATSAPP_CLOUD_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# O canal da cerimônia é e-mail: é o que o Mailpit captura e o que o teste lê.
SIGNATURE_DELIVERY_CHANNEL=email
# FALSE de propósito: com `true` o OTP não sai por e-mail e o Mailpit fica vazio.
SIGNATURE_DEV_ECHO_OTP=false

# Os crons ficam desligados — a emissão é disparada pela UI, quando o teste manda.
NFSE_SCHEDULER_ENABLED=false
PAINTER_NFSE_SCHEDULER_ENABLED=false

DISABLE_RATE_LIMITING=true
BACKUP_PATH=/home/kennedy/Documents/repositories/api/tests/e2e-ui/artifacts/backup
FILES_ROOT=/home/kennedy/Documents/repositories/api/tests/e2e-ui/artifacts/files
